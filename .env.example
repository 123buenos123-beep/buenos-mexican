# ─────────────────────────────────────────────────────────────────────────────
# Buenos Mexican — environment variables
#
# Copy this file to `.env.local` and fill in the real values.
# NEXT_PUBLIC_* variables are exposed to the browser; everything else is a
# server-only secret and must never be committed or shipped to the client.
#
# In production these are set in the Vercel project (Settings → Environment
# Variables), NOT in a file.
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase (Dashboard → Project Settings → API) ────────────────────────────
# Public project URL + anon/publishable key — safe to expose in the browser.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-publishable-key
# Service role key — SECRET. Bypasses Row Level Security; server routes only.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Cloudflare Turnstile (booking-form CAPTCHA) ──────────────────────────────
# Site key is public; secret key is server-side only.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your-turnstile-site-key
TURNSTILE_SECRET_KEY=your-turnstile-secret-key

# ── Resend (booking + newsletter email) ──────────────────────────────────────
RESEND_API_KEY=your-resend-api-key
# Must be a verified-domain sender — never onboarding@resend.dev.
RESEND_FROM_EMAIL=Buenos Mexican <newsletter@buenosmexicanrestaurant.com>

# ── Site ─────────────────────────────────────────────────────────────────────
# Canonical public URL; used to build links inside emails.
NEXT_PUBLIC_SITE_URL=https://buenosmexicanrestaurant.com

# ─────────────────────────────────────────────────────────────────────────────
# Supabase Edge Function (send-booking-email) secrets — set these in Supabase,
# NOT here:  supabase secrets set KEY=value   (or Dashboard → Edge Functions).
#   RESEND_API_KEY            – same Resend key as above
#   LINE_CHANNEL_ACCESS_TOKEN – LINE Messaging API token (manager alerts)
#   LINE_MANAGER_USER_ID      – LINE user id that receives booking alerts
#   GOOGLE_SHEET_WEBHOOK_URL  – Apps Script webhook for the Sheets backup
#   SITE_URL                  – canonical URL for links in booking emails
# (SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are injected automatically.)
# ─────────────────────────────────────────────────────────────────────────────
